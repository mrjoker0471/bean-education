# BEAN Education - environment variables (placeholder values only, never commit real .env)

# Prisma SQLite database file location (runtime artifact, kept outside git)
DATABASE_URL="file:./db/custom.db"

# ─── LiveKit (Phase 5 — Live Classroom) ──────────────────────────────────────
# Obtain from LiveKit Cloud (https://cloud.livekit.io) → project settings.
# See docs/PHASE5_LIVEKIT_SETUP.md. These are PLACEHOLDERS — never commit real
# credentials. The app stays fully usable when these are absent (live
# classrooms show an honest "not configured" state instead of faking one).

# WebSocket endpoint the BROWSER connects to, e.g. wss://your-project.livekit.cloud
LIVEKIT_WS_URL=
# HTTP endpoint the SERVER uses for room management (defaults derived from
# LIVEKIT_WS_URL when unset), e.g. https://your-project.livekit.cloud
LIVEKIT_HOST_URL=
# LiveKit API key (server-side only — never exposed to the frontend)
LIVEKIT_API_KEY=
# LiveKit API secret (server-side only — never exposed, never logged)
LIVEKIT_API_SECRET=

# ─── BEAN-side free-pilot usage caps (BEAN safety caps, NOT provider quotas) ─
# Monthly participant-minute allowance reserved before a room may start.
BEAN_LIVEKIT_MONTHLY_BUDGET_MINUTES=4000
# Global ceiling of simultaneously connected participants across all rooms.
BEAN_LIVEKIT_MAX_CONCURRENT_PARTICIPANTS=80
# Per-room participant ceiling (confirmed bookings + teacher, never above this).
BEAN_LIVEKIT_MAX_ROOM_PARTICIPANTS=51

# ─── Google OAuth (public-experience/auth milestone) ──────────────────────────
# Create credentials at Google Cloud Console (OAuth 2.0 Client ID, type Web).
# NEVER commit real credentials. While these are empty the Google button in the
# authentication flow is disabled with an honest message, and an attempted
# OAuth start returns a truthful configuration error — nothing is simulated.
GOOGLE_CLIENT_ID=
# Client secret — server-side only, never exposed to the frontend, never logged.
GOOGLE_CLIENT_SECRET=
# The exact redirect URI registered with Google, e.g.
# https://your-domain.example/api/auth/google/callback (https required in
# production; http is accepted only for loopback development hosts).
GOOGLE_REDIRECT_URI=

# ─── Runtime / background-worker knobs (all optional; every default shown is
# ─── the real in-code default — unset means the default applies) ──────────────

# Riishe document upload cap in megabytes (server-side, pre-read header check
# plus post-buffer re-check). Default 15.
RIISHE_MAX_UPLOAD_MB=15

# CI specialist-fleet worker pool concurrency (bounded 1–32). Default 4.
FLEET_WORKER_CONCURRENCY=4

# LiveKit observer pool: max simultaneously non-terminal observer sessions
# (bounded 1–16). Default 4.
BEAN_CI_OBSERVER_MAX_ACTIVE=4

# Automatic post-class fleet dispatch. Empty = off (explicit dispatch only).
# Set to exactly "true" to let the classroom lifecycle hooks fire-and-forget a
# fleet dispatch for a terminal class (consent is still re-checked at dispatch
# and at every claim — the flag alone never bypasses consent).
BEAN_CI_FLEET_AUTO_DISPATCH=

# Kill switch for the Classroom Intelligence model adapter. Empty = adapter
# available; "1" disables it (evaluations fail honestly instead of calling the
# provider). Server-side only.
CI_MODEL_ADAPTER_DISABLED=

# CI / fleet worker-loop test override. Normal runs (including production)
# start the worker loops automatically — eagerly at server boot via
# src/instrumentation.ts. The ONLY effect of "1" is to allow the loops to
# start under NODE_ENV=test as well. Leave empty.
CI_ENABLE_WORKER=

# Prisma query logging. Empty = off (the safe default; query logs can contain
# user content bound into statements). "1" enables it for diagnostics — never
# enable in production.
DB_QUERY_LOG=

# ─── OCR binaries (optional; honest degradation) ──────────────────────────────
# Scanned-PDF analysis needs tesseract + poppler on the host. When absent the
# pipeline degrades honestly to NEEDS_OCR. Generic deployments can point these
# at explicit paths instead of relying on $HOME/.local/bin or PATH.

# Absolute path to the tesseract binary (e.g. /usr/bin/tesseract).
TESSERACT_BIN=
# Absolute path to the pdftoppm binary (e.g. /usr/bin/pdftoppm).
POPPLER_BIN=
# Directory containing tessdata language files (e.g. /usr/share/tesseract-ocr/5/tessdata).
TESSDATA_PREFIX=

# ─── TLS / security header flag (optional) ────────────────────────────────────
# Send the Strict-Transport-Security header. Set to "true" ONLY once the site
# is actually served over HTTPS (TLS terminating at the edge). Never set it
# for plain-HTTP localhost development. Value: 180-day max-age, no
# includeSubDomains (the apex domain may host unrelated subdomains).
BEAN_ENABLE_HSTS=

# ─── Legal operator, grievance and policy versions (legal milestone) ─────────
# The ACTUAL contracting/legal operator — supplied by the owner. A product
# name is NOT assumed to be the registered legal entity. Public pages render
# an honest "to be provided" notice for any field left empty; nothing is
# invented. See docs/INDIA-DATA-PRIVACY-AND-PLATFORM-LEGAL-READINESS.md and
# scripts/legal-release-check.mjs.
BEAN_LEGAL_ENTITY_NAME=
BEAN_LEGAL_ENTITY_ADDRESS=

BEAN_CONSUMER_SUPPORT_EMAIL=
BEAN_CONSUMER_SUPPORT_PHONE=

BEAN_GRIEVANCE_OFFICER_NAME=
BEAN_GRIEVANCE_EMAIL=
BEAN_GRIEVANCE_PHONE=

BEAN_PRIVACY_CONTACT_EMAIL=

# Version identifiers surfaced on the public legal pages and validated
# server-side for signup/re-acceptance acceptance records.
BEAN_TERMS_VERSION=
BEAN_PRIVACY_VERSION=

# Document dates shown on the public legal pages (strict YYYY-MM-DD only;
# anything else is treated as unset and the pages say so honestly).
# LAST_UPDATED falls back to the date stamped in the version identifier when
# unset. EFFECTIVE_DATE is never guessed — until configured (and the legal
# review completes) the pages state that the document is not yet in effect.
BEAN_TERMS_LAST_UPDATED=
BEAN_TERMS_EFFECTIVE_DATE=
BEAN_PRIVACY_LAST_UPDATED=
BEAN_PRIVACY_EFFECTIVE_DATE=
