generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Catalogue ────────────────────────────────────────────────────────────────

model Category {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String?
  exams       Exam[]
}

model Exam {
  id             String   @id @default(cuid())
  slug           String   @unique
  name           String
  shortName      String?
  authority      String
  categorySlug   String
  state          String?
  description    String
  featured       Boolean  @default(false)
  status         String   @default("CURRENT") // CURRENT | ANNOUNCED | RECURRING
  syllabusStatus String   @default("UNVERIFIED") // VERIFIED | PARTIAL | UNVERIFIED
  contentNote    String? // honest note about preparation coverage
  sourceRefs     String? // JSON [{label, url}]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  category  Category       @relation(fields: [categorySlug], references: [slug])
  stages    Stage[]
  questions Question[]
  resources Resource[]
  attempts  Attempt[]
  templates TestTemplate[]

  @@index([categorySlug])
}

model Stage {
  id          String  @id @default(cuid())
  examId      String
  slug        String
  name        String
  order       Int     @default(0)
  paperNote   String? // short note about this stage/paper
  patternJson String? // JSON: {durationMin, marks, questions, negativeMark, qualifying?, sections:[{name,questions,marks,durationMin?}]}
  exam        Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)

  subjects  Subject[]
  questions Question[]
  templates TestTemplate[]

  @@unique([examId, slug])
}

model Subject {
  id          String  @id @default(cuid())
  stageId     String
  slug        String
  name        String
  description String?
  icon        String? // lucide icon name
  order       Int     @default(0)
  stage       Stage   @relation(fields: [stageId], references: [id], onDelete: Cascade)

  units     Unit[]
  questions Question[]
  templates TestTemplate[]

  @@unique([stageId, slug])
}

model Unit {
  id          String  @id @default(cuid())
  subjectId   String
  slug        String
  name        String
  description String?
  order       Int     @default(0)
  subject     Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  topics Topic[]

  @@unique([subjectId, slug])
}

model Topic {
  id            String  @id @default(cuid())
  unitId        String
  slug          String
  name          String
  order         Int     @default(0)
  description   String?
  canonicalSlug String? // links to shared note/question/resource library
  unit          Unit    @relation(fields: [unitId], references: [id], onDelete: Cascade)

  notes     Note[]
  questions Question[]
  resources Resource[]
  templates TestTemplate[]

  @@unique([unitId, slug])
  @@index([canonicalSlug])
}

// ─── Layer 1: Study material ──────────────────────────────────────────────────

model Note {
  id            String   @id @default(cuid())
  topicId       String
  canonicalSlug String
  title         String
  markdown      String
  version       String   @default("1.0")
  sourceRefs    String? // JSON [{label, url}]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  topic         Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([topicId])
}

model Resource {
  id                 String    @id @default(cuid())
  examId             String?
  topicId            String?
  canonicalSlug      String?
  title              String
  provider           String
  type               String // TEXTBOOK_PDF | STUDY_NOTES | ARTICLE | VIDEO | REVISION | ORIGINAL_GUIDE
  url                String
  language           String    @default("English")
  accessType         String    @default("FREE") // FREE | REGISTRATION | PAID
  verificationStatus String    @default("PENDING_REVIEW") // VERIFIED | UNREACHABLE | PENDING_REVIEW | PAID
  lastChecked        DateTime?
  attribution        String?
  note               String?
  fileKind           String?   // PDF | WEBPAGE | PORTAL — how the link should open (no fake PDF buttons)
  docDate            String?   // publication/revision date when verifiably known
  createdAt          DateTime  @default(now())
  exam               Exam?     @relation(fields: [examId], references: [id])
  topic              Topic?    @relation(fields: [topicId], references: [id])

  @@index([canonicalSlug])
  @@index([topicId])
}

// ─── Layer 2: Questions & tests ───────────────────────────────────────────────

model Question {
  id                 String   @id @default(cuid())
  examId             String
  stageId            String?
  subjectId          String?
  topicId            String?
  canonicalSlug      String
  text               String
  optionsJson        String // JSON string[]
  correctIndex       Int
  explanation        String
  difficulty         String   @default("MEDIUM") // EASY | MEDIUM | HARD
  language           String   @default("English")
  sourceType         String   @default("ORIGINAL") // ORIGINAL | PYQ_VERIFIED | PYQ_UNVERIFIED
  sourcePaper        String?
  year               Int?
  verificationStatus String   @default("VERIFIED") // for ORIGINAL: author-verified answer
  exam               Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  stage              Stage?   @relation(fields: [stageId], references: [id])
  subject            Subject? @relation(fields: [subjectId], references: [id])
  topic              Topic?   @relation(fields: [topicId], references: [id])

  // ── PYQ provenance & import audit (Phase 2A) ──
  pyqHash            String? // normalized content hash (text+options+key) for duplicate detection
  sourceRef          String? // source citation / document reference (page, booklet, archive id)
  importedBatchId    String? // PyqImportBatch.id — full audit trail of where this record came from
  reviewedBy         String? // reviewer identity (studentId) when a PYQ was verified
  reviewedAt         DateTime?
  reviewNote         String? // reviewer's verification note

  @@index([examId])
  @@index([topicId])
  @@index([canonicalSlug])
  @@index([pyqHash])
  @@index([sourceType, year])
  @@index([importedBatchId])
}

model TestTemplate {
  id          String    @id @default(cuid())
  slug        String    @unique
  examId      String?
  stageId     String?
  subjectId   String?
  topicId     String?
  title       String
  description String
  type        String // TOPIC | SUBJECT | MIXED | MOCK | REVISION
  configJson  String // JSON {count, durationMin, marksPerQuestion, negativeMark, sections?, filter}
  order       Int       @default(0)
  exam        Exam?     @relation(fields: [examId], references: [id])
  stage       Stage?    @relation(fields: [stageId], references: [id])
  subject     Subject?  @relation(fields: [subjectId], references: [id])
  topic       Topic?    @relation(fields: [topicId], references: [id])
  attempts    Attempt[]
}

// Topic back-relation for TestTemplate is intentionally omitted (topicId kept as plain FK)

// ─── Student activity ─────────────────────────────────────────────────────────

model Attempt {
  id              String        @id @default(cuid())
  guestId         String?
  userId          String?
  studentId       String? // set when a signed-in student owns this attempt (guest migration keeps guestId as well)
  templateId      String?
  examId          String?
  examLabel       String
  title           String
  topicId         String?
  subjectId       String?
  configJson      String // JSON snapshot of config
  questionIdsJson String // JSON string[] ordered
  answersJson     String? // JSON {[questionId]: selectedIndex}
  status          String        @default("IN_PROGRESS") // IN_PROGRESS | SUBMITTED | TIMED_OUT | ABANDONED
  score           Float?
  maxScore        Float?
  correctCount    Int?
  wrongCount      Int?
  skippedCount    Int?
  timeSpentSec    Int?
  perTopicJson    String? // JSON {topicId: {name, correct, total}}
  startedAt       DateTime      @default(now())
  submittedAt     DateTime?
  template        TestTemplate? @relation(fields: [templateId], references: [id])
  exam            Exam?         @relation(fields: [examId], references: [id])
  source          String        @default("BANK") // BANK (catalogue questions) | RIISHE (AI-generated set)
  documentId      String?
  riisheTestId    String?
  riisheTest      RiisheTest?   @relation(fields: [riisheTestId], references: [id])

  @@index([guestId])
  @@index([studentId])
  @@index([status])
}

// ─── Riishe: uploaded study material → AI analysis → generated tests ─────────

model StudyDocument {
  id             String   @id @default(cuid())
  guestId        String
  studentId      String? // set when a signed-in student owns this document
  title          String // user-editable display title
  originalName   String
  storedPath     String // path under db/uploads (never web-served directly)
  mimeType       String
  fileSize       Int
  pageCount      Int?
  status         String   @default("QUEUED") // QUEUED | EXTRACTING | ANALYSING | READY | NEEDS_OCR | FAILED
  statusDetail   String? // honest human-readable status/limitation message
  contentHash    String // sha256 of file bytes — dedupe + analysis cache key
  extractionJson String? // JSON [{page, chars, text, scanned}]
  analysisJson   String? // JSON DocumentAnalysisDTO
  examLabel      String? // optional exam association (label only — no FK to catalogue)
  subjectLabel   String?
  topicLabel     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  tests          RiisheTest[]

  @@index([guestId])
  @@index([studentId])
  @@index([contentHash])
}

model RiisheTest {
  id               String        @id @default(cuid())
  guestId          String
  studentId        String? // set when a signed-in student owns this test
  documentId       String // PRIMARY source document (workspace owner)
  title            String
  status           String        @default("QUEUED") // QUEUED | GENERATING | READY | FAILED
  statusDetail     String?
  focusTopicsJson  String? // JSON string[] — empty/null = balanced mix across the document
  weakFocus        Boolean       @default(false) // generated from the student's weak areas
  requestedCount   Int           @default(50)
  configJson       String // JSON {timed, durationMin, marksPerQuestion, negativeMark, scoringModel?, patternLabel?}
  distributionJson String? // JSON {category: requested count} — respects the student's category mix
  sourceDocIdsJson String? // JSON string[] — every source document beyond the primary (multi-doc practice)
  statsJson        String? // JSON {generated, validated, rejected, byCategory, byDifficulty, llmCalls, batches}
  questionIdsJson  String? // ordered ids of PUBLISHED validated questions
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  document         StudyDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  questions        RiisheQuestion[]
  attempts         Attempt[]

  @@index([guestId])
  @@index([studentId])
  @@index([documentId])
}

model RiisheQuestion {
  id             String     @id @default(cuid())
  testId         String
  documentId     String
  order          Int        @default(0)
  text           String
  optionsJson    String // JSON string[4]
  correctIndex   Int
  explanation    String
  difficulty     String     @default("MEDIUM") // EASY | MEDIUM | HARD
  category       String     @default("APPLICATION") // FOUNDATION | APPLICATION | STATEMENT | MULTISTEP | MISCONCEPTION
  topic          String?
  pageRefsJson   String? // JSON number[] — pages in the source document
  evidence       String? // supporting excerpt from the document
  status         String     @default("VALIDATED") // VALIDATED | FLAGGED
  validationNote String?
  test           RiisheTest @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@index([testId])
  @@index([documentId])
}

model RiisheExplanation {
  id          String   @id @default(cuid())
  attemptId   String
  questionId  String
  status      String   @default("READY") // READY | FAILED
  payloadJson String? // JSON RiisheExplanationDTO
  createdAt   DateTime @default(now())

  @@unique([attemptId, questionId])
  @@index([attemptId])
}

// ─── Riishe follow-up chat (persisted, guest-scoped) ──────────────────────────
// Scope: document chat (documentId set), per-question review chat (attemptId +
// questionId set), or whole-library hub chat (both null). Turns are never
// shared across guests.

model RiisheChatTurn {
  id              String   @id @default(cuid())
  guestId         String
  studentId       String? // set when a signed-in student owns this turn
  documentId      String?
  attemptId       String?
  questionId      String?
  role            String // user | assistant
  content         String
  pagesCitedJson  String? // JSON number[]
  grounding       String? // document | mixed | general (assistant turns only)
  sourcesJson     String? // JSON RiisheChatSourceDTO[]
  createdAt       DateTime @default(now())

  @@index([guestId, createdAt])
  @@index([studentId, createdAt])
  @@index([documentId])
  @@index([attemptId, questionId])
}

// ─── Student identity (Phase 2A) ────────────────────────────────────────────
// Credentials: scrypt password hashing (node:crypto) — passwords are NEVER
// stored in plaintext. Sessions: a random 256-bit token lives only in an
// httpOnly cookie; the database stores its SHA-256 hash.

model Student {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String // scrypt$N$r$p$salt$hash
  displayName     String?
  learningLevel   String? // SCHOOL_6_8 | SCHOOL_9_10 | SCHOOL_11_12 | UNDERGRAD | POSTGRAD | PROFESSIONAL | COMPETITIVE | SKILL
  interestsJson   String? // JSON string[] — subject interests
  preferencesJson String? // JSON {dailyMinutes, language, revisionStyle, goalExam, educationCategory, learningStyle}
  // Authorization role (Phase 2B). Normal registration ALWAYS creates STUDENT;
  // PYQ_CURATOR / ADMIN exist only via the operator CLI (scripts/grant-role.ts).
  // There is no API route that can raise a role.
  role            String    @default("STUDENT") // STUDENT | PYQ_CURATOR | ADMIN
  onboardedAt     DateTime? // set when the student finishes onboarding (Phase 2B)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  sessions        Session[]
  goals           StudyGoal[]
  // BEAN Teach (Phase 4A): teacher capability = an approved TeacherProfile,
  // NOT a new role — one account can be student, curator/admin and teacher.
  teacherProfile  TeacherProfile?
  classBookings   ClassBooking[]
  // BEAN Live Classroom (Phase 5): per-person verified attendance evidence.
  liveParticipants LiveClassParticipant[]
  // BEAN Trust & Quality (Phase 6)
  reviewsWritten    ClassReview[]
  complaintsFiled   TeachComplaint[]
  appealsFiled      TeachAppeal[]
  // BEAN Institution & Career (Phase 7) — all powers stay organization-scoped;
  // these relations NEVER grant a new global role.
  organizationMemberships OrganizationMembership[]
  assignmentSubmissions   AssignmentSubmission[]
  careerProfile           CareerProfile?
  careerSkills            StudentCareerSkill[]
  careerProjects          CareerProject[]
  careerCredentials       CareerCredential[]
  careerEligibilityReview CareerEligibilityReview?
  careerApplications      CareerApplication[]
  careerSafetyReports     CareerSafetyReport[]

  @@index([role])
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique // sha256(token) — the raw token exists only in the cookie
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([studentId])
}

model StudyGoal {
  id         String    @id @default(cuid())
  studentId  String
  student    Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title      String
  examId     String?
  topicId    String?
  targetDate DateTime?
  status     String    @default("ACTIVE") // ACTIVE | COMPLETED | ARCHIVED
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([studentId, status])
}

// ─── PYQ import audit trail (Phase 2A) ───────────────────────────────────
// Every structured import is recorded with its source identity and counts;
// only reviewed records may be relabelled PYQ_VERIFIED (see
// docs/PHASE2A_PYQ_INGESTION.md).

model PyqImportBatch {
  id             String   @id @default(cuid())
  paperTitle     String
  examSlug       String? // catalogue exam identity when known
  examLabel      String? // free-text exam identity when not in the catalogue
  stageLabel     String?
  subjectLabel   String?
  year           Int?
  session        String?
  sourceCitation String?
  fileName       String
  importedBy     String? // studentId of the curator/admin who ran the import
  totalRows      Int      @default(0)
  createdCount   Int      @default(0)
  duplicateCount Int      @default(0)
  failedCount    Int      @default(0)
  errorsJson     String? // JSON [{row, error}] — per-row audit
  createdAt      DateTime @default(now())
}

// Append-only review audit trail (Phase 2B). Every approve/reject decision on a
// PYQ row writes one event here (reviewer, role, action, justification, time),
// so a later re-review never erases the earlier decision's record.
model PyqReviewEvent {
  id           String   @id @default(cuid())
  questionId   String
  reviewerId   String // Student.id of the curator/admin who acted
  reviewerRole String // role held at decision time
  action       String // APPROVE | REJECT
  note         String? // written justification (mandatory for APPROVE)
  createdAt    DateTime @default(now())

  @@index([questionId, createdAt])
  @@index([reviewerId, createdAt])
}

// ─── Durable background jobs (Phase 2A) ────────────────────────────────
// Replaces the in-process Maps in jobs.ts. One row per (kind, refId);
// atomic claims inside a SQLite write transaction; lease-based recovery.

model RiisheJob {
  id          String    @id @default(cuid())
  kind        String // DOCUMENT_ANALYSIS | TEST_GENERATION | EXPLANATION
  refId       String // StudyDocument.id | RiisheTest.id | Attempt.id
  ownerId     String // guestId or studentId — scope for limits & quotas
  status      String    @default("QUEUED") // QUEUED | RUNNING | COMPLETED | FAILED | CANCELLED
  attempts    Int       @default(0)
  maxAttempts Int       @default(2)
  payloadJson String? // optional run parameters (e.g. {"force":true} for re-analysis)
  error       String?
  claimedAt   DateTime?
  leaseUntil  DateTime?
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([kind, refId])
  @@index([status, leaseUntil])
  @@index([ownerId, status])
}

// Hourly provider-protection quota, durable across restarts. `count` includes
// in-flight reservations; failures/cancellations release their reservation.
model JobQuota {
  id          String   @id @default(cuid())
  ownerKey    String // guestId or studentId
  kind        String // analyse | generate | explain
  windowKey   String // ISO hour bucket, e.g. "2026-11-18T09"
  windowStart DateTime
  count       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([ownerKey, kind, windowKey])
  @@index([windowStart])
}

// ─── BEAN Teach (Phase 4A): teacher marketplace — free pilot foundation ──────
// Teachers are NOT a new role. The teacher capability is an APPROVED
// TeacherProfile attached to the existing authenticated Student, so the single
// Student.role field (STUDENT | PYQ_CURATOR | ADMIN) is untouched and accounts
// that are also PYQ curators or administrators stay valid. All classes in this
// milestone are FREE PILOTS: no orders, payments, wallets or payouts exist.
// `plannedPricePaise` is stored as metadata for a future milestone only.

model TeacherProfile {
  id                 String    @id @default(cuid())
  studentId          String    @unique // one profile per Student
  teachingName       String // public teaching name — never a real-name requirement
  headline           String
  bio                String
  subjectsJson       String // JSON string[]
  levelsJson         String // JSON string[] — education levels served
  languagesJson      String // JSON string[]
  qualificationsText String // qualification details reviewed by admins
  experienceYears    Int
  portfolioUrl       String? // optional public portfolio / professional profile URL
  // Verification state machine: PENDING → APPROVED | REJECTED. Resubmission
  // after rejection — or a verification-relevant profile edit by an APPROVED
  // teacher — returns the profile to PENDING (re-review). Only APPROVED +
  // isPublished profiles appear in the public marketplace.
  verificationStatus String    @default("PENDING") // PENDING | APPROVED | REJECTED
  isPublished        Boolean   @default(false) // set true automatically on approval; teacher can unpublish
  reviewedBy         String? // Student.id of the admin who decided the current state
  reviewedAt         DateTime?
  reviewNote         String? // latest decision note — PRIVATE (applicant + admins only)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  student            Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classSessions      ClassSession[]
  // BEAN Trust & Quality (Phase 6)
  classReviews       ClassReview[]
  reviewResponses    TeacherReviewResponse[]
  trustActions       TrustAction[]
  complaintsAbout    TeachComplaint[]

  @@index([verificationStatus])
}

// Append-only audit trail for BEAN Teach. One row per decision: teacher
// review (TEACHER_PROFILE), class cancellation (CLASS_SESSION) and attendance
// marking (CLASS_BOOKING). Rows are NEVER updated or deleted — a re-review
// appends a new event, so earlier decisions remain provable.
// (Polymorphic by design: entityId is a plain string, no FK on purpose.)
model TeachAuditEvent {
  id         String   @id @default(cuid())
  entityType String // TEACHER_PROFILE | CLASS_SESSION | CLASS_BOOKING
  entityId   String // TeacherProfile.id | ClassSession.id | ClassBooking.id
  actorId    String // Student.id of the actor (applicant / teacher / admin)
  actorRole  String // role held at decision time (STUDENT | PYQ_CURATOR | ADMIN)
  action     String // SUBMIT | RESUBMIT | EDIT_REVIEW | APPROVE | REJECT | CLASS_CANCELLED | ATTENDANCE_MARKED
  detail     String? // context (e.g. rejection reason, attendance transition)
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}

model ClassSession {
  id                String    @id @default(cuid())
  teacherProfileId  String
  title             String
  description       String
  subject           String
  targetLevel       String // education level the class is aimed at
  language          String
  durationMinutes   Int // 60..360 in 30-minute increments (enforced server-side)
  startsAt          DateTime // stored in UTC; display renders in `timeZone`
  timeZone          String // IANA time zone selected by the teacher
  capacity          Int // 1..50
  minimumStudents   Int // 1..capacity
  // Seats currently held = bookings whose status is NOT CANCELLED. Maintained
  // ONLY inside transactions with conditional updates (see
  // src/lib/teach-booking.ts) so concurrent last-seat bookings cannot overrun.
  bookedCount       Int       @default(0)
  // METADATA ONLY during the free pilot — never charged, no order is created.
  plannedPricePaise Int       @default(0)
  status            String    @default("DRAFT") // DRAFT | PUBLISHED | CANCELLED | COMPLETED
  publishedAt       DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  teacherProfile    TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)
  bookings          ClassBooking[]
  // BEAN Live Classroom (Phase 5): one primary live session per scheduled class.
  liveSession       LiveClassSession?
  // BEAN Trust & Quality (Phase 6)
  reviews           ClassReview[]
  // BEAN Institution (Phase 7): private institution classes. Nullable + safe
  // defaults — every existing class stays PUBLIC and unchanged.
  audience            String?     @default("PUBLIC") // PUBLIC | ORGANIZATION | GROUP
  organizationId      String?
  organizationGroupId String?
  organization        Organization?        @relation(fields: [organizationId], references: [id])
  organizationGroup   OrganizationGroup?   @relation(fields: [organizationGroupId], references: [id])

  @@index([status, startsAt])
  @@index([teacherProfileId, startsAt])
  @@index([organizationId, audience])
}

model ClassBooking {
  id                 String    @id @default(cuid())
  classSessionId     String
  studentId          String
  status             String    @default("CONFIRMED") // CONFIRMED | CANCELLED | ATTENDED | NO_SHOW
  bookedAt           DateTime  @default(now())
  cancelledAt        DateTime?
  attendanceMarkedAt DateTime? // set when the teacher marks ATTENDED / NO_SHOW
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  classSession       ClassSession @relation(fields: [classSessionId], references: [id], onDelete: Cascade)
  student            Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  // BEAN Trust & Quality (Phase 6): a review is tied to exactly one booking.
  review             ClassReview?

  // One booking record per student per class — rebooking after cancellation
  // re-activates the SAME row (never a duplicate), keeping history intact.
  @@unique([classSessionId, studentId])
  @@index([classSessionId, status])
  @@index([studentId, status])
}

// ─── BEAN Live Classroom (Phase 5): realtime class delivery ──────────────────
// Additive milestone on top of the Phase 4A marketplace. Realtime media is
// carried by LiveKit Cloud; BEAN owns identity, authorisation, scheduling,
// usage budgeting, attendance evidence and audit. No media is ever recorded,
// stored or replayed — the classroom is live-only (docs/PHASE5_SECURITY.md).
//
// One LiveClassSession row exists per scheduled ClassSession (unique FK). A
// room that FAILED before anyone joined may be retried by REUSING the same row
// (the reviewed retry design) — history and audit stay in one place. An ENDED
// session can never restart.

model LiveClassSession {
  id                          String    @id @default(cuid())
  classSessionId              String    @unique // one primary live session per ClassSession
  roomName                    String    @unique // server-generated opaque id — never an email or display name
  status                      String    @default("READY") // READY | LIVE | ENDED | INTERRUPTED | FAILED
  startedAt                   DateTime?
  endedAt                     DateTime?
  startedById                 String // Student.id of the owner teacher who started the room
  endedById                   String? // Student.id of who ended it (owner teacher / provider event)
  // BEAN-side conservative reservation against the monthly allowance:
  // (confirmed bookings + 1 teacher) × scheduled duration. Released at
  // finalisation; actual verified usage is then recorded once.
  reservedParticipantMinutes  Int       @default(0)
  actualParticipantMinutes    Int? // written exactly once by the single-use finalisation guard
  usageFinalisedAt            DateTime? // set when usage was reconciled — makes double-finalisation impossible
  usageMonthKey               String // "2026-11" (UTC) — the month whose allowance this session reserved
  endReason                   String? // teacher_ended | provider_room_finished | failed_room_creation | failed_unknown
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt
  classSession                ClassSession        @relation(fields: [classSessionId], references: [id], onDelete: Cascade)
  participants                LiveClassParticipant[]
  whiteboard                  LiveWhiteboardState?

  @@index([status])
  @@index([usageMonthKey])
}

// Per-person verified attendance evidence. Rows are created/updated ONLY by
// signed LiveKit webhook events (idempotent processing) — never by client
// claims. Connection intervals are clamped so out-of-order events can never
// produce negative durations or double-counted time.
model LiveClassParticipant {
  id                    String    @id @default(cuid())
  liveClassSessionId    String
  studentId             String // Student.id — the opaque BEAN identity behind the LiveKit participant
  participantIdentity   String // LiveKit identity ("bean:<studentId>") — unique within a live session
  participantRole       String // TEACHER | STUDENT
  firstJoinedAt         DateTime?
  activeSince           DateTime? // open connection interval (null = currently disconnected)
  lastLeftAt            DateTime?
  totalConnectedSeconds Int       @default(0) // accumulated verified connected time
  reconnectCount        Int       @default(0) // completed reconnections (join → leave → join)
  lastEventAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  liveSession           LiveClassSession @relation(fields: [liveClassSessionId], references: [id], onDelete: Cascade)
  student               Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([liveClassSessionId, participantIdentity])
  @@index([liveClassSessionId])
  @@index([studentId])
}

// Webhook processing state. `providerEventId` (LiveKit's own event id) is
// unique, so redeliveries can never double-apply accounting. No raw payloads
// are stored — only the minimum needed for idempotency and debugging.
model LiveKitWebhookEvent {
  id               String    @id @default(cuid())
  providerEventId  String    @unique // LiveKit event.id — idempotency key
  eventName        String // room_started | room_finished | participant_joined | participant_left | participant_connection_aborted
  roomName         String
  receivedAt       DateTime  @default(now())
  processedAt      DateTime?
  processingStatus String    @default("PROCESSED") // PROCESSED | SKIPPED | FAILED
  errorCode        String? // short machine-readable reason when SKIPPED/FAILED

  @@index([roomName, receivedAt])
}

// Monthly participant-minute accounting. `reservedParticipantMinutes` holds
// conservative in-flight reservations; `usedParticipantMinutes` grows only
// from verified webhook/finalisation evidence. Availability is ALWAYS computed
// as budget − reserved − used inside a single conditional UPDATE — the amount
// can never go negative and concurrent room starts cannot oversubscribe.
model LiveUsageMonth {
  id                         String   @id @default(cuid())
  monthKey                   String   @unique // "2026-11" (UTC)
  budgetParticipantMinutes   Int
  reservedParticipantMinutes Int      @default(0)
  usedParticipantMinutes     Int      @default(0)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
}

// Whiteboard snapshot for late joiners. One row per live session (unique FK);
// written ONLY by the session's teacher through a BEAN API. Bounded by strict
// server-side limits (max snapshot bytes + max strokes) — no images, no
// recordings, no arbitrary HTML/script payloads.
model LiveWhiteboardState {
  id                 String   @id @default(cuid())
  liveClassSessionId String   @unique
  snapshotJson       String // JSON WBProtocolSnapshot (validated, bounded)
  version            Int      @default(0) // monotonically increasing snapshot version
  updatedById        String // Student.id of the teacher who saved
  updatedAt          DateTime @updatedAt
  liveSession        LiveClassSession @relation(fields: [liveClassSessionId], references: [id], onDelete: Cascade)
}

// ─── BEAN Trust & Quality (Phase 6): verified reviews, complaints, appeals ───
// Additive milestone on top of Phase 4A/5. Reviews are ALWAYS tied to one real
// booking with final ATTENDED status (DB-level unique constraint on bookingId).
// Complaints are private support records — never public, never part of rating
// math. All moderation/admin decisions keep append-only event history. There
// are still NO payments, wallets or refunds: the pilot stays free (Phase 8).

// Verified class review. One per booking (bookingId unique). Rating bounds are
// enforced by server validation (Zod + service check) on every write path.
model ClassReview {
  id               String    @id @default(cuid())
  bookingId        String    @unique // one review per booking — DB-level guarantee
  classSessionId   String
  teacherProfileId String
  studentId        String
  rating           Int // 1..5 — validated server-side on create AND edit
  title            String? // optional, bounded (5..120 chars)
  reviewText       String // bounded (20..2000 chars), plain text only
  status           String    @default("PUBLISHED") // PUBLISHED | FLAGGED | HIDDEN
  // FLAGGED keeps the review publicly visible (flagging is never auto-hiding);
  // it is excluded from aggregate metrics while under moderation and returns
  // to PUBLISHED when an admin decides to keep it.
  isVerified       Boolean   @default(true) // true by construction: booking-verified path only
  showDisplayName  Boolean   @default(false) // explicit student consent to show their displayName
  editedAt         DateTime? // set on in-window self edits (7-day window)
  publishedAt      DateTime?
  moderatedAt      DateTime? // last admin moderation decision time
  moderationReason String? // PRIVATE — visible to admins and the review author only
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  booking          ClassBooking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  classSession     ClassSession      @relation(fields: [classSessionId], references: [id], onDelete: Cascade)
  teacherProfile   TeacherProfile    @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)
  student          Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  response         TeacherReviewResponse?

  @@index([classSessionId, status])
  @@index([teacherProfileId, status])
  @@index([studentId, createdAt])
}

// Teacher's public reply under a review. One per review (unique FK); only the
// approved owner teacher of the reviewed class can create it. Teachers can
// never edit the student's review itself.
model TeacherReviewResponse {
  id               String    @id @default(cuid())
  reviewId         String    @unique // one response per review
  teacherProfileId String // must be the reviewed class's owner profile
  responseText     String // bounded (20..1000 chars), plain text only
  editedAt         DateTime? // in-window self edit (7-day window)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  review           ClassReview     @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  teacherProfile   TeacherProfile  @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)

  @@index([teacherProfileId])
}

// Private complaint / incident report. Never public, never in teacher-facing
// DTOs beyond an anonymous open-count. Sensitive categories (safeguarding,
// harassment, discrimination) are restricted to ADMIN eyes server-side.
model TeachComplaint {
  id               String    @id @default(cuid())
  complainantId    String // Student.id of the reporter — never exposed to teachers
  classSessionId   String? // optional product relationship anchor
  classBookingId   String? // optional: the reporter's own booking in that class
  teacherProfileId String? // optional: teacher the complaint concerns
  category         String // TEACHING_QUALITY | MISLEADING_CLASS_DESCRIPTION | TEACHER_CONDUCT | STUDENT_CONDUCT | SAFEGUARDING | HARASSMENT | DISCRIMINATION | CLASS_CANCELLATION | TECHNICAL_PROBLEM | ATTENDANCE_DISPUTE | OTHER
  severity         String    @default("NORMAL") // LOW | NORMAL | HIGH | CRITICAL — server-derived, not client-asserted
  isSensitive      Boolean   @default(false) // SAFEGUARDING | HARASSMENT | DISCRIMINATION → ADMIN-only visibility
  subject          String // bounded (8..120)
  description      String // bounded (30..4000)
  status           String    @default("OPEN") // OPEN | ACKNOWLEDGED | UNDER_REVIEW | WAITING_FOR_INFORMATION | RESOLVED | DISMISSED
  assignedAdminId  String?
  resolvedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  complainant      Student          @relation(fields: [complainantId], references: [id], onDelete: Cascade)
  teacherProfile   TeacherProfile?  @relation(fields: [teacherProfileId], references: [id], onDelete: SetNull)
  events           ComplaintEvent[]

  @@index([status, severity])
  @@index([complainantId, createdAt])
  @@index([assignedAdminId, status])
  @@index([teacherProfileId])
}

// Append-only complaint history: every status change, assignment, note and
// decision is recorded once and never rewritten (duplicates are no-ops).
model ComplaintEvent {
  id          String   @id @default(cuid())
  complaintId String
  actorId     String // Student.id of complainant or admin
  actorRole   String // role held at event time
  action      String // CREATED | ACKNOWLEDGED | UNDER_REVIEW | WAITING_FOR_INFORMATION | RESOLVED | DISMISSED | ASSIGNMENT_CHANGED | NOTE_ADDED | INFO_PROVIDED | ESCALATED
  detail      String? // bounded note — PRIVATE (admins; complainant sees own-provided info only)
  createdAt   DateTime @default(now())
  complaint   TeachComplaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@index([complaintId, createdAt])
}

// Teacher trust restriction / notice record. NOTICE and WARNING are records
// without enforcement; PAUSE_LISTINGS hides current listings and blocks new
// bookings; SUSPEND_PUBLISHING blocks class creation/publishing;
// EMERGENCY_STOP (the immediate-safeguarding procedure) additionally blocks
// live classroom start/token for this teacher's classes. Restrictions expire
// predictably (endsAt) and are deactivated by REINSTATE. Filing a complaint
// NEVER creates a trust action automatically.
model TrustAction {
  id               String    @id @default(cuid())
  teacherProfileId String
  action           String // NOTICE | WARNING | PAUSE_LISTINGS | SUSPEND_PUBLISHING | EMERGENCY_STOP | REINSTATE
  reason           String // mandatory documented grounds (20..1000)
  startsAt         DateTime  @default(now())
  endsAt           DateTime? // null = until explicitly reinstated
  isActive         Boolean   @default(true) // false for REINSTATE rows and ended restrictions
  createdByAdminId String
  endedAt          DateTime? // set on expiry sweep / reinstatement
  endedById        String?
  createdAt        DateTime  @default(now())
  teacherProfile   TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)

  @@index([teacherProfileId, isActive])
}

// Appeal against a complaint decision, review moderation or trust action.
// The original decision is never silently overwritten: the appeal carries its
// own decision record, and OVERTURNED applies only documented restorations.
model TeachAppeal {
  id                 String    @id @default(cuid())
  appellantId        String // Student.id — must hold the product relationship
  targetType         String // COMPLAINT_DECISION | REVIEW_MODERATION | TRUST_ACTION
  targetId           String // TeachComplaint.id | ClassReview.id | TrustAction.id
  originalDecisionById String? // server-captured: admin who made the original decision (self-review ban)
  reason             String // bounded (30..2000)
  status             String    @default("SUBMITTED") // SUBMITTED | UNDER_REVIEW | UPHELD | OVERTURNED | CLOSED
  assignedReviewerId String?
  decision           String? // UPHELD | OVERTURNED | CLOSED
  decisionNote       String?
  decidedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  appellant          Student     @relation(fields: [appellantId], references: [id], onDelete: Cascade)
  events             AppealEvent[]

  @@index([appellantId, status])
  @@index([targetType, targetId])
}

// Append-only appeal history.
model AppealEvent {
  id        String   @id @default(cuid())
  appealId  String
  actorId   String
  actorRole String
  action    String // SUBMITTED | ASSIGNED | UNDER_REVIEW | DECIDED | CLOSED
  detail    String?
  createdAt DateTime @default(now())
  appeal    TeachAppeal @relation(fields: [appealId], references: [id], onDelete: Cascade)

  @@index([appealId, createdAt])
}

// ══════════════════════════════════════════════════════════════════════════════
// BEAN Institution & Career Ecosystem (Phase 7) — additive only.
// No existing column is altered except the three nullable ClassSession fields
// above (safe PUBLIC defaults). Institution/employer power is organization-
// scoped via OrganizationMembership; Student.role is never elevated by any of
// these models. All state machines are enforced server-side (src/lib/
// institution.ts, src/lib/career.ts) and recorded in append-only event tables.
// ══════════════════════════════════════════════════════════════════════════════

// A verified organization means its identity was reviewed by BEAN. It does NOT
// mean BEAN certifies government recognition, accreditation, affiliation or
// academic quality — UI copy must reflect this truthfully.
model Organization {
  id                 String    @id @default(cuid())
  name               String // official organization name
  displayName        String?
  orgType            String // SCHOOL | COLLEGE | UNIVERSITY | COACHING_CENTRE | PROFESSIONAL_INSTITUTE | SKILL_PROVIDER | EMPLOYER | OTHER
  description        String?
  website            String?
  publicContact      String? // public contact info only — never private student data
  country            String?
  state              String?
  city               String?
  slug               String    @unique
  logoText           String? // short emoji/mark for the profile header (no upload pipeline in Phase 7)
  // DRAFT | PENDING_REVIEW | APPROVED | REJECTED | SUSPENDED — every transition
  // is a deliberate human admin decision recorded in OrganizationAuditEvent.
  verificationStatus String    @default("DRAFT")
  verificationNote   String? // private admin note — never exposed to the organization
  reviewedByAdminId  String?
  reviewedAt         DateTime?
  rejectionReason    String?
  isActive           Boolean   @default(true) // soft archival; orgs with history are never hard-deleted
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  memberships        OrganizationMembership[]
  invitations        OrganizationInvitation[]
  groups             OrganizationGroup[]
  announcements      OrganizationAnnouncement[]
  resources          OrganizationResource[]
  assignments        OrganizationAssignment[]
  issuedCredentials  CareerCredential[]
  opportunities      CareerOpportunity[]
  classes            ClassSession[]
  auditEvents        OrganizationAuditEvent[]

  @@index([verificationStatus])
  @@index([orgType])
}

// One Student may hold different scoped memberships across different
// organizations. A membership NEVER elevates Student.role.
model OrganizationMembership {
  id                    String    @id @default(cuid())
  organizationId        String
  studentId             String
  // OWNER | ADMIN | INSTRUCTOR | STAFF | LEARNER | CAREER_COORDINATOR | RECRUITER
  role                  String    @default("LEARNER")
  status                String    @default("INVITED") // INVITED | ACTIVE | SUSPENDED | LEFT
  invitedByMembershipId String? // historical reference, no FK (history survives)
  activatedAt           DateTime?
  suspendedAt           DateTime?
  leftAt                DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  student               Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  groupEnrollments      OrganizationGroupMembership[]

  @@unique([organizationId, studentId])
  @@index([studentId])
  @@index([organizationId, status])
}

// Secure invitation-based enrolment. Only a SHA-256 token hash is stored — the
// raw token appears exactly once in the admin UI copy-link workflow and is
// never persisted or logged. Invitations can never grant OWNER or ADMIN.
model OrganizationInvitation {
  id                    String    @id @default(cuid())
  organizationId        String
  email                 String? // when set, only that account may accept
  intendedRole          String // INSTRUCTOR | STAFF | LEARNER | CAREER_COORDINATOR | RECRUITER
  tokenHash             String    @unique
  createdByMembershipId String // historical reference
  expiresAt             DateTime
  maxUses               Int?
  useCount              Int       @default(0)
  acceptedAt            DateTime?
  acceptedByStudentId   String?
  revokedAt             DateTime?
  createdAt             DateTime  @default(now())
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// Group / batch / cohort inside an organization.
model OrganizationGroup {
  id                    String    @id @default(cuid())
  organizationId        String
  name                  String
  academicYear          String?
  programmeLabel        String? // course / programme
  batchLabel            String?
  sectionLabel          String?
  trackLabel            String? // subject or training track
  startsAt              DateTime?
  endsAt                DateTime?
  capacity              Int?
  status                String    @default("ACTIVE") // ACTIVE | ARCHIVED
  createdByMembershipId String
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  enrollments           OrganizationGroupMembership[]
  assignments           OrganizationAssignment[]
  classes               ClassSession[]
  announcements         OrganizationAnnouncement[]
  resources             OrganizationResource[]

  @@index([organizationId, status])
}

// Enrollment of an organization member into a group. Unique pair prevents
// duplicate active enrollment; records survive a member leaving (enrollmentState
// flips to LEFT — rows are never deleted for history).
model OrganizationGroupMembership {
  id              String    @id @default(cuid())
  groupId         String
  membershipId    String
  enrollmentState String    @default("ACTIVE") // ACTIVE | LEFT
  joinedAt        DateTime  @default(now())
  leftAt          DateTime?
  group           OrganizationGroup      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  membership      OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([groupId, membershipId])
  @@index([membershipId])
}

// Append-only organization history: registration, verification decisions,
// membership role changes, invitation lifecycle, group enrollment, assignment
// publication, credential issuance/revocation. Never cascade-deleted.
model OrganizationAuditEvent {
  id             String   @id @default(cuid())
  organizationId String
  entityType     String // ORGANIZATION | MEMBERSHIP | INVITATION | GROUP | GROUP_MEMBERSHIP | ASSIGNMENT | CREDENTIAL | ANNOUNCEMENT | RESOURCE
  entityId       String
  actorId        String?
  actorRole      String?
  action         String
  detail         String?
  createdAt      DateTime @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
}

// In-app institutional communication (no email service exists; none is faked).
model OrganizationAnnouncement {
  id                 String    @id @default(cuid())
  organizationId     String
  groupId            String? // scoped to one group when set
  authorMembershipId String
  title              String
  body               String
  status             String    @default("PUBLISHED") // DRAFT | PUBLISHED | ARCHIVED
  publishedAt        DateTime?
  expiresAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  organization       Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  group              OrganizationGroup? @relation(fields: [groupId], references: [id])

  @@index([organizationId, status])
}

// Learning resources shared by an institution (external HTTPS links only —
// private documents stay inside the existing student-owned Riishe storage).
model OrganizationResource {
  id                 String   @id @default(cuid())
  organizationId     String
  groupId            String?
  authorMembershipId String
  title              String
  description        String?
  url                String // validated https URL
  createdAt          DateTime @default(now())
  organization       Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  group              OrganizationGroup? @relation(fields: [groupId], references: [id])

  @@index([organizationId])
}

// Institution assignment. Only group instructors / org staff can publish;
// students see assignments only for groups they are actively enrolled in.
model OrganizationAssignment {
  id                    String    @id @default(cuid())
  organizationId        String
  groupId               String
  createdByMembershipId String
  title                 String
  instructions          String?
  subjectLabel          String?
  submissionType        String    @default("TEXT_AND_LINK") // TEXT | EXTERNAL_LINK | TEXT_AND_LINK
  status                String    @default("DRAFT") // DRAFT | PUBLISHED | CLOSED | ARCHIVED
  publishedAt           DateTime?
  dueAt                 DateTime?
  maxScore              Int?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  organization          Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  group                 OrganizationGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  submissions           AssignmentSubmission[]

  @@index([organizationId, groupId, status])
}

// One submission record per student per assignment (unique pair). Resubmission
// updates this row while the assignment accepts work; grades and feedback are
// private to the student and permitted institutional staff — never public.
model AssignmentSubmission {
  id                    String    @id @default(cuid())
  assignmentId          String
  studentId             String
  responseText          String?
  externalLink          String? // validated https URL
  status                String    @default("DRAFT") // DRAFT | SUBMITTED | RETURNED | GRADED
  submittedAt           DateTime?
  gradedByMembershipId  String? // historical reference
  gradeValue            String? // free-form grade label (institution-defined)
  teacherFeedback       String?
  gradedAt              DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  assignment            OrganizationAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student               Student                @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
  @@index([assignmentId, status])
}

// Student-owned career profile. PRIVATE by default — nothing is exposed to
// employers merely because a student registered with BEAN.
model CareerProfile {
  id                 String   @id @default(cuid())
  studentId          String   @unique
  headline           String?
  summary            String?
  preferredRoleTypes String? // JSON string[]
  preferredSkills    String? // JSON string[]
  preferredLocations String? // JSON string[]
  workModes          String? // JSON string[]
  // PRIVATE | DISCOVERABLE | PAUSED. Discovery additionally requires an
  // APPROVED CareerEligibilityReview (adult-eligibility safeguard) — both
  // conditions are server-enforced.
  visibility         String   @default("PRIVATE")
  publicSlug         String?  @unique
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  student            Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([visibility])
}

// Truthful skill labels only: a self-declared skill is never shown as verified.
model StudentCareerSkill {
  id                String   @id @default(cuid())
  studentId         String
  skillName         String
  proficiency       String? // e.g. BEGINNER | INTERMEDIATE | ADVANCED (free label allowed)
  description       String?
  verificationLabel String   @default("SELF_DECLARED") // SELF_DECLARED | INSTITUTION_ISSUED | BEAN_ASSESSMENT_VERIFIED
  sourceRef         String? // issuing organization or assessment reference
  position          Int      @default(0) // student-controlled ordering
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  student           Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, position])
}

// Portfolio projects. PRIVATE by default; students individually choose what to
// share. External links are validated; untrusted HTML is never embedded.
model CareerProject {
  id          String    @id @default(cuid())
  studentId   String
  title       String
  description String?
  category    String? // ACADEMIC | PERSONAL | PRACTICAL | INTERNSHIP | RESEARCH | SKILL_DEMO
  skillsUsed  String? // JSON string[]
  projectUrl  String?
  startsAt    DateTime?
  endsAt      DateTime?
  visibility  String    @default("PRIVATE") // PRIVATE | SHARED
  status      String    @default("ACTIVE") // ACTIVE | ARCHIVED
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, visibility])
}

// Institution-issued credential. Only an authorized membership of an APPROVED
// organization can issue; issuance and revocation are audited. Students control
// portfolio sharing via portfolioShared.
model CareerCredential {
  id                    String    @id @default(cuid())
  studentId             String
  issuerOrganizationId  String
  credentialName        String
  credentialDescription String?
  issuedDate            DateTime
  expiryDate            DateTime?
  credentialReference   String?
  status                String    @default("ISSUED") // ISSUED | REVOKED
  issuedByMembershipId  String // historical reference
  portfolioShared       Boolean   @default(false)
  verifiedAt            DateTime  @default(now()) // institution verification moment
  revokedAt             DateTime?
  revokedByMembershipId String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  student               Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  issuerOrganization    Organization @relation(fields: [issuerOrganizationId], references: [id])

  @@index([studentId, status])
  @@index([issuerOrganizationId])
}

// Adult-eligibility safeguard (server-enforced): candidate discovery and job
// applications require APPROVED status from a documented admin review. No raw
// identity documents or numbers are ever collected or stored. Private career
// planning and portfolio preparation remain available without approval.
model CareerEligibilityReview {
  id               String    @id @default(cuid())
  studentId        String    @unique
  status           String    @default("NOT_ELIGIBLE") // NOT_ELIGIBLE | PENDING_REVIEW | APPROVED | DENIED
  requestedAt      DateTime?
  reviewedByAdminId String?
  reviewedAt       DateTime?
  decisionReason   String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  student          Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([status])
}

// Job / internship / apprenticeship / project listing. Only an APPROVED
// EMPLOYER organization can create; admin review gates public publication.
// compensationDescription is informational metadata — it never triggers any
// payment processing (no payments exist anywhere in Phase 7).
model CareerOpportunity {
  id                     String    @id @default(cuid())
  employerOrganizationId String
  title                  String
  description            String
  responsibilities       String?
  requiredSkills         String? // JSON string[]
  preferredSkills        String? // JSON string[]
  location               String?
  workMode               String? // ONSITE | REMOTE | HYBRID (free label allowed)
  opportunityType        String // JOB | INTERNSHIP | APPRENTICESHIP | PROJECT
  compensationDescription String?
  applicationDeadline    DateTime?
  eligibilityDescription String?
  status                 String    @default("DRAFT") // DRAFT | PENDING_REVIEW | PUBLISHED | PAUSED | CLOSED | REJECTED
  reviewedByAdminId      String?
  reviewedAt             DateTime?
  rejectionReason        String?
  publishedAt            DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  organization           Organization       @relation(fields: [employerOrganizationId], references: [id])
  applications           CareerApplication[]

  @@index([status, opportunityType])
  @@index([employerOrganizationId, status])
}

// Application to an opportunity. Unique pair prevents duplicate applications at
// the database level. The submission-time snapshot (selected profile fields,
// projects, credentials) is bounded JSON and is NEVER silently rewritten by
// later profile changes. employerNotes is private to the employer and must
// never appear in student DTOs.
model CareerApplication {
  id                     String    @id @default(cuid())
  opportunityId          String
  studentId              String
  status                 String    @default("SUBMITTED") // SUBMITTED | UNDER_REVIEW | SHORTLISTED | INTERVIEW | SELECTED | REJECTED | WITHDRAWN
  snapshotJson           String
  contactSharingConsent  Boolean   @default(false)
  employerNotes          String? // employer-private
  candidateVisibleStatusNote String?
  withdrawnAt            DateTime?
  submittedAt            DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  opportunity            CareerOpportunity @relation(fields: [opportunityId], references: [id])
  student                Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([opportunityId, studentId])
  @@index([studentId, status])
  @@index([opportunityId, status])
}

// Private safety report against a listing or organization conduct. Reports
// NEVER auto-suspend anything — every enforcement is a recorded human decision.
model CareerSafetyReport {
  id              String    @id @default(cuid())
  reporterId      String
  targetType      String // OPPORTUNITY | ORGANIZATION
  targetId        String
  category        String // FRAUDULENT_LISTING | MISLEADING_DESCRIPTION | ORGANIZATION_CONDUCT | HARASSMENT | DISCRIMINATION | SAFEGUARDING | OTHER
  subject         String
  description     String
  status          String    @default("OPEN") // OPEN | UNDER_REVIEW | RESOLVED | DISMISSED
  assignedAdminId String?
  resolutionNote  String? // admin-private
  resolvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  reporter        Student   @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([reporterId])
}

// Append-only career ecosystem history: opportunity moderation, application
// status changes, eligibility decisions, safety decisions. Sensitive evidence
// and complaint descriptions are never logged here.
model CareerAuditEvent {
  id        String   @id @default(cuid())
  entityType String // OPPORTUNITY | APPLICATION | ELIGIBILITY | SAFETY_REPORT | CREDENTIAL
  entityId  String
  actorId   String?
  actorRole String?
  action    String
  detail    String?
  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}
